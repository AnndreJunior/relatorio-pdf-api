{
  "name": "relatorio-pdf-api",
  "description": "Estudo de como gerar um relatório pdf em um sistema.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && tsc",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "format": "prettier . --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnndreJunior/relatorio-pdf-api.git"
  },
  "keywords": [],
  "author": "AnndreJunior",
  "type": "module",
  "bugs": {
    "url": "https://github.com/AnndreJunior/relatorio-pdf-api/issues"
  },
  "homepage": "https://github.com/AnndreJunior/relatorio-pdf-api#readme",
  "imports": {
    "#src/*": "./dist/*.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.10",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsc-alias": "^1.9.11",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@fastify/autoload": "^6.6.0",
    "@fastify/env": "^7.0.1",
    "@fastify/postgres": "^6.1.2",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.5",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
